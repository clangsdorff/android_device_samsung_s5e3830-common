Subject: [PATCH 1/7] keyboard: add a toggle to hide the ime back button in the
 navigation bar

wire a switch on the keyboard settings page to
ime_back_in_navbar_enabled, right under the ime switcher button toggle,
so the user can hide the dismiss button under the keyboard.
---
 res/values/ime_back_button_strings.xml        |  5 +++
 res/xml/keyboard_settings.xml                 |  6 +++
 ...eBackButtonInNavBarPreferenceController.kt | 45 +++++++++++++++++++
 3 files changed, 56 insertions(+)
 create mode 100644 res/values/ime_back_button_strings.xml
 create mode 100644 src/com/android/settings/inputmethod/ImeBackButtonInNavBarPreferenceController.kt

diff --git a/res/values/ime_back_button_strings.xml b/res/values/ime_back_button_strings.xml
new file mode 100644
index 00000000000..a74e0fa589b
--- /dev/null
+++ b/res/values/ime_back_button_strings.xml
@@ -0,0 +1,5 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="ime_back_button_in_navbar_title">Show the hide keyboard key</string>
+    <string name="ime_back_button_in_navbar_summary">Show the button that hides the keyboard in the navigation bar, when an input field is selected</string>
+</resources>
diff --git a/res/xml/keyboard_settings.xml b/res/xml/keyboard_settings.xml
index 106002680e9..ae79c697406 100644
