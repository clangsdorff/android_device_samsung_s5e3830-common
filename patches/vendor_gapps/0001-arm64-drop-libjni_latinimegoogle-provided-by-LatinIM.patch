From 1e17fbaf7ba9921a45a6da22e6b0d175782d523a Mon Sep 17 00:00:00 2001
From: Langsdorff <131063968+clangsdorff@users.noreply.github.com>
Date: Fri, 27 Nov 2026 18:50:11 +0000
Subject: [PATCH 1/1] arm64: drop libjni_latinimegoogle provided by LatinIME

crDroid ships libjni_latinimegoogle (32-bit and 64-bit) directly in
packages/inputmethods/LatinIME, causing a packaging conflict in the
generated product image when vendor/gapps also installs it.
---
 arm64/Android.bp      | 7 -------
 arm64/arm64-vendor.mk | 1 -
 2 files changed, 8 deletions(-)

diff --git a/arm64/Android.bp b/arm64/Android.bp
index c800163..1a83492 100644
--- a/arm64/Android.bp
+++ b/arm64/Android.bp
@@ -94,13 +94,6 @@ android_app_import {
     product_specific: true,
 }
 
-cc_prebuilt_library_shared {
-    name: "libjni_latinimegoogle",
-    srcs: ["proprietary/product/lib64/libjni_latinimegoogle.so"],
-    prefer: true,
-    product_specific: true,
-}
-
 prebuilt_apex {
     name: "com.google.android.gmssystem.prodvic",
     owner: "gapps",
diff --git a/arm64/arm64-vendor.mk b/arm64/arm64-vendor.mk
index 8880865..cc7d359 100644
--- a/arm64/arm64-vendor.mk
+++ b/arm64/arm64-vendor.mk
@@ -6,7 +6,6 @@ PRODUCT_SOONG_NAMESPACES += \
 
 PRODUCT_PACKAGES += \
     Phonesky \
-    libjni_latinimegoogle \
     com.google.android.gmssystem.prodvic
 
 ifeq ($(TARGET_IS_GROUPER),)
-- 
2.43.0

