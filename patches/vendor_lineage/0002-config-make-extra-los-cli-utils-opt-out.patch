From 1bb5d40987a3990a4fc691d84fdacb0913979733 Mon Sep 17 00:00:00 2001
From: fukiame <fukiame@proton.me>
Date: Fri, 27 Nov 2026 18:38:00 +0000
Subject: [PATCH 2/2] config: make extra los cli utils opt out

Signed-off-by: fukiame <fukiame@proton.me>
---
 config/common.mk | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/config/common.mk b/config/common.mk
index 6b7d99b9..d01b3fd0 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -169,6 +169,7 @@ PRODUCT_PACKAGES += \
     SimpleDeviceConfig \
     SimpleSettingsConfig
 
+ifneq ($(TARGET_EXCLUDE_LOS_EXTRA_CLI_UTILS),true)
 # Extra tools in Lineage
 PRODUCT_PACKAGES += \
     bash \
@@ -179,13 +180,16 @@ PRODUCT_PACKAGES += \
     setcap \
     vim
 
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/bin/curl \
+    system/bin/getcap \
+    system/bin/setcap
+endif
+
 PRODUCT_PACKAGES += \
     nano_recovery
 
 PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
-    system/bin/curl \
-    system/bin/getcap \
-    system/bin/setcap \
     system/%/libzstd.so
 
 # fastbootd
@@ -211,6 +215,7 @@ PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/bin/wipe-frp.sh:$(TARGET_COPY_OUT_RECOVERY)/root/system/bin/wipe-frp
 
+ifneq ($(TARGET_EXCLUDE_LOS_EXTRA_CLI_UTILS),true)
 # Openssh
 PRODUCT_PACKAGES += \
     scp \
@@ -223,14 +228,17 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     vendor/lineage/prebuilt/common/etc/init/init.openssh.rc:$(TARGET_COPY_OUT_PRODUCT)/etc/init/init.openssh.rc
+endif
 
 # OverlayFS
 PRODUCT_PACKAGES_DEBUG += \
     disable-overlays
 
+ifneq ($(TARGET_EXCLUDE_LOS_EXTRA_CLI_UTILS),true)
 # rsync
 PRODUCT_PACKAGES += \
     rsync
+endif
 
 # Storage manager
 PRODUCT_PRODUCT_PROPERTIES += \
-- 
2.43.0

