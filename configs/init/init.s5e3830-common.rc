on init
    mkdir /dev/cpuset/surfaceflinger
    write /dev/cpuset/surfaceflinger/cpus 0-7
    copy /dev/cpuset/mems /dev/cpuset/surfaceflinger/mems
    chown system system /dev/cpuset/surfaceflinger
    chown system system /dev/cpuset/surfaceflinger/tasks
    chown system system /dev/cpuset/surfaceflinger/cgroup.procs
    chmod 0775 /dev/cpuset/surfaceflinger
    chmod 0664 /dev/cpuset/surfaceflinger/tasks
    chmod 0664 /dev/cpuset/surfaceflinger/cgroup.procs

    chown system graphics /dev/graphics/fb0

    start watchdogd

on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    swapon_all /vendor/etc/fstab.s5e3830

on boot
    chown system system /sys/class/power_supply/battery/batt_slate_mode
    chown system system /sys/class/thermal/cooling_device0/cur_state
    chown system system /sys/class/thermal/cooling_device1/cur_state
    chown system system /sys/class/thermal/cooling_device2/cur_state
    chown system radio /sys/class/sec/tsp/cmd
    chown system system /sys/class/sec/tsp/ear_detect_enable
    chown system system /sys/class/sec/tsp/prox_power_off
    chown system system /sys/class/sec/tsp/virtual_prox
    chown system system /sys/class/sec/tsp/sensitivity_mode
    chown system system /sys/class/sec/tsp/hw_param
    chown root system /proc/tsp_msg
    chmod 0440 /proc/tsp_msg
    setprop vendor.thermal.link_ready 1

on property:sys.boot_completed=1
    setprop vendor.powerhal.init 1
    write /dev/cpuctl/top-app/cpu.uclamp.min 6.25
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/kernel/sched_pelt_multiplier 2

service vendor.power-hal-aidl /vendor/bin/hw/android.hardware.power-service.pixel-libperfmgr
    override
    class hal
    user root
    group system radio
    priority -20

service watchdogd /system/bin/watchdogd 10 30
    class core
    oneshot
    priority -10
    seclabel u:r:watchdogd:s0

service vendor.hwcomposer-2-2 /vendor/bin/hw/android.hardware.graphics.composer@2.2-service
    override
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ProcessCapacityHigh
